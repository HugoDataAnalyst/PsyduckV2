# Environment for the PsyduckV2 app container in the local test stack.
# Mounted over /app/.env (config.py loads it with override=True).
# Named app.env because .gitignore excludes any file called ".env".

DB_NAME=PsyduckV2
DB_HOST=mariadb
DB_PORT=3306
DB_USER=psyduck
DB_PASSWORD=psyduck

REDIS_HOST=redis
REDIS_SERVER_PORT=6379
REDIS_GUI_PORT=8001
REDIS_DB=1
REDIS_PASSWORD=testpass

LOG_LEVEL=INFO
LOG_FILE=True
LOG_LEVEL_DASHBOARD=INFO
LOG_FILE_DASHBOARD=False

KOJI_URL=http://fake-koji:8080
KOJI_TOKEN=test
KOJI_PROJECT_NAME=test

GOLBAT_HOST=0.0.0.0
GOLBAT_WEBHOOK_PORT=5050
GOLBAT_DB_HOST=mariadb
GOLBAT_DB_PORT=3306
GOLBAT_DB_NAME=golbat
GOLBAT_DB_USER=psyduck
GOLBAT_DB_PASSWORD=psyduck

UVICORN_WORKERS=1

WEBHOOK_IP=0.0.0.0
API_BASE_URL=http://127.0.0.1:5050
